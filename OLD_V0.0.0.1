import pygame
import sys
import random

# Init
pygame.init()

# Screen
WIDTH = 400
HEIGHT = 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Flappy Bird")

# Colors
WHITE = (255, 255, 255)
GREEN = (0, 200, 0)
BLUE = (135, 206, 235)

# Clock
clock = pygame.time.Clock()

# Bird
bird_x = 100
bird_y = HEIGHT // 2
bird_velocity = 0
gravity = 0.5
jump = -8

# Pipes
pipe_width = 60
pipe_gap = 150
pipe_velocity = 3

pipes = []

def create_pipe():
    height = random.randint(100, 400)
    return {"x": WIDTH, "top": height, "bottom": height + pipe_gap}

# Score
score = 0
font = pygame.font.SysFont(None, 40)

def draw_text(text, x, y):
    img = font.render(text, True, (0,0,0))
    screen.blit(img, (x, y))

# Game loop
running = True

while running:
    screen.fill(BLUE)

    # Events
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()

        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_SPACE:
                bird_velocity = jump

    # Bird physics
    bird_velocity += gravity
    bird_y += bird_velocity

    # Draw bird
    pygame.draw.circle(screen, (255, 255, 0), (bird_x, int(bird_y)), 15)

    # Pipes
    if len(pipes) == 0 or pipes[-1]["x"] < WIDTH - 200:
        pipes.append(create_pipe())

    for pipe in pipes:
        pipe["x"] -= pipe_velocity

        # Draw pipes
        pygame.draw.rect(screen, GREEN, (pipe["x"], 0, pipe_width, pipe["top"]))
        pygame.draw.rect(screen, GREEN, (pipe["x"], pipe["bottom"], pipe_width, HEIGHT))

        # Collision
        if (bird_x > pipe["x"] and bird_x < pipe["x"] + pipe_width):
            if (bird_y < pipe["top"] or bird_y > pipe["bottom"]):
                running = False

        # Score
        if pipe["x"] == bird_x:
            score += 1

    # Remove pipes
    pipes = [p for p in pipes if p["x"] > -pipe_width]

    # Ground / sky collision
    if bird_y <= 0 or bird_y >= HEIGHT:
        running = False

    # Score display
    draw_text(f"Score: {score}", 10, 10)

    pygame.display.update()
    clock.tick(60)

print("Game Over! Score:", score)
pygame.quit()  
    